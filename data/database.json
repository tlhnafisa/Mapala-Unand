    {
      "id": 5,
      "judul": "Pelatihan Navigasi Darat dan Survival Anggota Muda 2026",
      "slug": "pelatihan-navigasi-darat-survival-2026",
      "kategori": "berita-edukasi",
      "foto": "/images/hero-mountain.jpg",
