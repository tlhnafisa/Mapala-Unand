    {
      "id": 4,
      "judul": "Arung Jeram & Navigasi Batang Tarusan",
      "slug": "arung-jeram-navigasi-batang-tarusan",
      "kategori": "kegiatan-lapangan",
      "foto": "/images/rafting.jpg",
      "tanggal": "2024-07-05",
      "status": "terbit",
      "penulis": "admin",
      "ringkasan": "Pengarungan jeram grade IV+, pemetaan titik bahaya hidrologi, serta edukasi kesiapsiagaan banjir bandang nagari.",
      "isi": "<p>Divisi Olahraga Air Mapala UNAND sukses menuntaskan ekspedisi pengarungan Sungai Batang Tarusan di Kabupaten Pesisir Selatan. Pengarungan sejauh 28 kilometer ini menembus jeram-jeram teknis kelas IV+ sekaligus melakukan pemetaan profil hidrologi dan titik penumpukan sedimentasi kayu untuk peringatan dini mitigasi banjir luapan.</p>",
      "status_kegiatan": "Sukses Lapangan",
